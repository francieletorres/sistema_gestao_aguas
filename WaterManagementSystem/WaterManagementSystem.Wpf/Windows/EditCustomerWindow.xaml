<Window x:Class="WaterManagementSystem.Wpf.Windows.EditCustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WaterManagementSystem.Wpf.Windows"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Editar Cliente" 
        Width="1024"
        Height="768"
        MinHeight="650"
        MinWidth="1000">
    <Grid Background="White">

        <Grid.RowDefinitions>
            <RowDefinition Height="185"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <Image Grid.Row="0"
               Grid.RowSpan="3"
               Source="/WaterManagementSystem.Wpf;component/Images/back2.png"
               Height="210"
               Stretch="Uniform"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Bottom"
               Opacity="0.80"
               IsHitTestVisible="False"
               Margin="0,0,0,10"/>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,20,0,0">

            <Image Source="/WaterManagementSystem.Wpf;component/Images/logoAzul1.png"
                   Width="120"
                   Height="120"
                   Stretch="Uniform"/>

            <TextBlock Text="Editar Cliente"
                       Foreground="Black"
                       FontSize="25"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Formulário -->
        <Grid Grid.Row="1"
              Width="650"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="0,15,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="175"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="58"/>
                <RowDefinition Height="58"/>
                <RowDefinition Height="58"/>
                <RowDefinition Height="58"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="75"/>
            </Grid.RowDefinitions>

            <!-- Nome -->
            <Label Grid.Row="0"
                   Grid.Column="0"
                   Content="Nome:"
                   FontSize="16"
                   Foreground="Black"
                   VerticalAlignment="Center"/>

            <TextBox x:Name="txtName"
                     Grid.Row="0"
                     Grid.Column="1"
                     Height="35"
                     FontSize="15"
                     Padding="7,3"
                     BorderThickness="1"
                     VerticalAlignment="Center"/>

            <!-- Morada -->
            <Label Grid.Row="1"
                   Grid.Column="0"
                   Content="Morada:"
                   FontSize="16"
                   Foreground="Black"
                   VerticalAlignment="Center"/>

            <TextBox x:Name="txtAddress"
                     Grid.Row="1"
                     Grid.Column="1"
                     Height="35"
                     FontSize="15"
                     Padding="7,3"
                     BorderThickness="1"
                     VerticalAlignment="Center"/>

            <!-- Contacto -->
            <Label Grid.Row="2"
                   Grid.Column="0"
                   Content="Contacto:"
                   FontSize="16"
                   Foreground="Black"
                   VerticalAlignment="Center"/>

            <TextBox x:Name="txtPhone"
                     Grid.Row="2"
                     Grid.Column="1"
                     Height="35"
                     FontSize="15"
                     Padding="7,3"
                     MaxLength="9"
                     BorderThickness="1"
                     VerticalAlignment="Center"/>

            <!-- NIF -->
            <Label Grid.Row="3"
                   Grid.Column="0"
                   Content="NIF:"
                   FontSize="16"
                   Foreground="Black"
                   VerticalAlignment="Center"/>

            <TextBox x:Name="txtTaxNumber"
                     Grid.Row="3"
                     Grid.Column="1"
                     Height="35"
                     FontSize="15"
                     Padding="7,3"
                     MaxLength="9"
                     BorderThickness="1"
                     VerticalAlignment="Center"/>

            <!-- Email -->
            <Label Grid.Row="4"
                   Grid.Column="0"
                   Content="Email:"
                   FontSize="16"
                   Foreground="Black"
                   VerticalAlignment="Center"/>

            <TextBox x:Name="txtEmail"
                     Grid.Row="4"
                     Grid.Column="1"
                     Height="35"
                     FontSize="15"
                     Padding="7,3"
                     BorderThickness="1"
                     VerticalAlignment="Center"/>

            <!-- Estado -->
            <Label Grid.Row="5"
                   Grid.Column="0"
                   Content="Estado do cliente:"
                   FontSize="16"
                   Foreground="Black"
                   VerticalAlignment="Center"/>

            <CheckBox x:Name="chkIsActive"
                      Grid.Row="5"
                      Grid.Column="1"
                      Content="Ativo"
                      FontSize="16"
                      Foreground="Black"
                      VerticalAlignment="Center"/>

            <!-- Botões -->
            <StackPanel Grid.Row="6"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,15,0,0">

                <Button x:Name="btnCancel"
                        Content="Cancelar"
                        Click="btnCancel_Click"
                        Width="150"
                        Height="48"
                        FontSize="17"
                        Foreground="White"
                        Background="#173B63"
                        BorderBrush="#173B63"
                        BorderThickness="1"
                        Cursor="Hand"
                        Margin="0,0,25,0"/>

                <Button x:Name="btnSave"
                        Content="Guardar"
                        Click="btnSave_Click"
                        Width="150"
                        Height="48"
                        FontSize="17"
                        Foreground="White"
                        Background="#173B63"
                        BorderBrush="#173B63"
                        BorderThickness="1"
                        Cursor="Hand"/>

            </StackPanel>

        </Grid>

        <!-- Imagem inferior -->
        <Image Grid.Row="2"
               Source="/WaterManagementSystem.Wpf;component/Images/editBackground.png"
               Stretch="Fill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Bottom"
               IsHitTestVisible="False"/>

    </Grid>
</Window>
