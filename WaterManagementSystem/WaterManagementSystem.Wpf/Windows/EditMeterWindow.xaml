<Window x:Class="WaterManagementSystem.Wpf.Windows.EditMeterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WaterManagementSystem.Wpf.Windows"
        mc:Ignorable="d"
        Title="Edit Meter"  
        WindowStartupLocation="CenterScreen"
        Width="1024"
        Height="768"
        MinHeight="650"
        MinWidth="1000">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="105"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#173B63">

            <Grid Margin="35,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="/WaterManagementSystem.Wpf;component/Images/logo.png"
                       Width="100"
                       Height="100"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="Editar Contador"
                               FontSize="23"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <TextBlock Text="Atualização dos dados do contador"
                               Margin="0,4,0,0"
                               FontSize="14"
                               Foreground="#DCE7F2"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="100,35,100,35">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">

                <TextBlock Text="Editar Contador"
                           FontSize="25"
                           FontWeight="SemiBold"
                           Foreground="#1D2C3C"/>

                <TextBlock Text="Altere os dados necessários e guarde as modificações."
                           Margin="0,4,0,0"
                           FontSize="14"
                           Foreground="#677482"/>
            </StackPanel>

            <Border Grid.Row="2"
                    Padding="22"
                    Background="White"
                    BorderBrush="#D8DEE5"
                    BorderThickness="1"
                    CornerRadius="6"
                    VerticalAlignment="Top">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="25"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="3">

                        <TextBlock Text="Cliente"
                                   Margin="0,0,0,5"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#243447"/>

                        <TextBox x:Name="txtCustomerName"
                                    Height="34"
                                    FontSize="14"
                                    IsReadOnly="True"
                                    Background="#F2F2F2"
                                    VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                Grid.Column="0">

                        <TextBlock Text="Data de instalação"
                                   Margin="0,0,0,5"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#243447"/>

                        <DatePicker x:Name="dpInstallationDate"
                                    Height="34"
                                    FontSize="14"
                                    IsEnabled="False"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                Grid.Column="2">

                        <TextBlock Text="Estado do contador"
                                   Margin="0,0,0,10"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#243447"/>

                        <CheckBox x:Name="chkIsActive"
                                  Content="Contador ativo"
                                  FontSize="14"
                                  Foreground="#243447"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button x:Name="btnCancel"
                                Content="Cancelar"
                                Click="btnCancel_Click"
                                Width="115"
                                Height="36"
                                Margin="0,0,10,0"
                                Background="#E7ECF1"
                                Foreground="#243447"
                                BorderBrush="#C5CDD5"
                                FontSize="14"
                                Cursor="Hand"/>

                        <Button x:Name="btnSave"
                                Content="Guardar"
                                Click="btnSave_Click"
                                Width="115"
                                Height="36"
                                Background="#176B87"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="14"
                                Cursor="Hand"/>
                    </StackPanel>

                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="#173B63">

            <TextBlock Text="Sistema de Gestão de Água"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="White"/>
        </Border>

    </Grid>
</Window>
