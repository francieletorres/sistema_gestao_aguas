<Window x:Class="WaterManagementSystem.Wpf.Windows.EditConsumptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WaterManagementSystem.Wpf.Windows"
        mc:Ignorable="d"
        Title="EditConsumptionWindow"
        Width="1024"
        Height="768"
        MinHeight="650"
        MinWidth="1000"
        Background="#F5F7FA"
        WindowStartupLocation="CenterScreen">
    <Grid Background="White">

        <Grid.RowDefinitions>
            <RowDefinition Height="105"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0"
            Background="#1E466F">

            <Grid Margin="80,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                   Source="/Images/logo.png"
                   Width="95"
                   Height="95"
                   Stretch="Uniform"/>

                <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="20,0,0,0">

                    <TextBlock Text="Editar Consumo"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="White"/>

                    <TextBlock Text="Atualização dos dados do consumo"
                           Margin="0,5,0,0"
                           FontSize="14"
                           Foreground="White"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- Conteúdo -->
        <Grid Grid.Row="1"
          Margin="100,35,100,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                   Text="Editar Consumo"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="#14283D"/>

            <TextBlock Grid.Row="1"
                   Text="Altere os dados necessários e guarde as modificações."
                   Margin="0,5,0,20"
                   FontSize="14"
                   Foreground="#66788A"/>

            <Border Grid.Row="2"
                Padding="22"
                VerticalAlignment="Top"
                Background="White"
                BorderBrush="#D6DEE6"
                BorderThickness="1"
                CornerRadius="6">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="25"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cliente -->
                    <StackPanel Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="3">

                        <TextBlock Text="Cliente"
                               Margin="0,0,0,5"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#243447"/>

                        <TextBox x:Name="txtCustomerName"
                             Height="34"
                             IsReadOnly="True"
                             FontSize="14"
                            Background="#F1F3F5"
                            Foreground="#6C757D"
                             VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- Contador -->
                    <StackPanel Grid.Row="2"
                            Grid.Column="0">

                        <TextBlock Text="Contador"
                               Margin="0,0,0,5"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#243447"/>

                        <TextBox x:Name="txtMeterNumber"
                             Height="34"
                             IsReadOnly="True"
                             FontSize="14"
                             Background="#F1F3F5"
                             Foreground="#6C757D"
                             VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- Data -->
                    <StackPanel Grid.Row="2"
                            Grid.Column="2">

                        <TextBlock Text="Data da leitura"
                               Margin="0,0,0,5"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#243447"/>

                        <TextBox x:Name="txtReadingDate"
                             Height="34"
                             IsReadOnly="True"
                             FontSize="14"
                             Background="#F1F3F5"
                             Foreground="#6C757D"
                             VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- Leitura -->
                    <StackPanel Grid.Row="4"
                            Grid.Column="0">

                        <TextBlock Text="Leitura"
                               Margin="0,0,0,5"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#243447"/>

                        <TextBox x:Name="txtMeterReading"
                             Height="34"
                             FontSize="14"
                             VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- Observação -->
                    <StackPanel Grid.Row="4"
                            Grid.Column="2">

                        <TextBlock Text="Observação"
                               Margin="0,0,0,5"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#243447"/>

                        <TextBox x:Name="txtNotes"
                             Height="34"
                             FontSize="14"
                             VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- Botões -->
                    <StackPanel Grid.Row="6"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                        <Button x:Name="btnCancel"
                            Content="Cancelar"
                            Click="btnCancel_Click"
                            Width="115"
                            Height="38"
                            Margin="0,0,10,0"
                            Background="#E7ECF1"
                            Foreground="#243447"
                            BorderBrush="#C5CDD5"
                            FontSize="14"
                            Cursor="Hand"/>

                        <Button x:Name="btnSave"
                            Content="Guardar"
                            Click="btnSave_Click"
                            Width="115"
                            Height="38"
                            Background="#176B87"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="14"
                            Cursor="Hand"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

        <!-- Rodapé -->
        <Border Grid.Row="2"
            Background="#1E466F">

            <TextBlock Text="Sistema de Gestão de Água"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="12"
                   Foreground="White"/>

        </Border>

    </Grid>
</Window>
