<Window x:Class="WaterManagementSystem.Wpf.Windows.InvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WaterManagementSystem.Wpf.Windows"
        mc:Ignorable="d"
        Title="Invoice" 
        WindowStartupLocation="CenterScreen"  
        Width="1024"
        Height="768"
        MinHeight="650"
        MinWidth="1000"
        Background="#F5F7FA">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="95"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#173B63">

            <Grid Margin="35,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="/WaterManagementSystem.Wpf;component/Images/logo.png"
                       Width="85"
                       Height="85"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="Gestão de Faturação"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <TextBlock Text="Geração, consulta, pagamento e anulação de faturas"
                               Margin="0,3,0,0"
                               FontSize="13"
                               Foreground="#DCE7F2"/>

                </StackPanel>

            </Grid>

        </Border>

        <Grid Grid.Row="1"
              Margin="35,16,35,16">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">

                <TextBlock Text="Faturas"
                           FontSize="23"
                           FontWeight="SemiBold"
                           Foreground="#1D2C3C"/>

                <TextBlock Text="Selecione um consumo para gerar uma fatura ou consulte as faturas já emitidas."
                           Margin="0,2,0,0"
                           FontSize="13"
                           Foreground="#677482"/>

            </StackPanel>

            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#D8DEE5"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="15">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="1.8*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Cliente"
                                   Margin="0,0,0,4"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#243447"/>

                        <ComboBox x:Name="cbCustomers"
                                  Height="32"
                                  FontSize="13"
                                  DisplayMemberPath="Name"
                                  VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <StackPanel Grid.Column="2">

                        <TextBlock Text="Contador"
                                   Margin="0,0,0,4"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#243447"/>

                        <ComboBox x:Name="cbMeters"
                                  Height="32"
                                  FontSize="13"
                                  DisplayMemberPath="MeterId"
                                  VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <StackPanel Grid.Column="4">

                        <TextBlock Text="Consumo"
                                   Margin="0,0,0,4"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#243447"/>

                        <ComboBox x:Name="cbConsumptions"
                                  Height="32"
                                  FontSize="13"
                                  VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <StackPanel Grid.Column="6"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom">

                        <Button x:Name="btnClearGeneration"
                                Content="Limpar"
                                Width="90"
                                Height="32"
                                Margin="0,0,8,0"
                                Background="#E7ECF1"
                                Foreground="#243447"
                                BorderBrush="#C5CDD5"
                                FontSize="12"
                                Cursor="Hand"/>

                        <Button x:Name="btnGenerateInvoice"
                                Content="Gerar fatura"
                                Width="115"
                                Height="32"
                                Background="#176B87"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="12"
                                Cursor="Hand"/>

                    </StackPanel>

                </Grid>

            </Border>

            <Border Grid.Row="4"
                    Background="White"
                    BorderBrush="#D8DEE5"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">

                        <TextBlock Text="Consultar faturas"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#243447"/>

                        <TextBlock Text="Pesquise por cliente, período e estado de pagamento."
                                   Margin="0,2,0,0"
                                   FontSize="12"
                                   Foreground="#677482"/>

                    </StackPanel>
                    
                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="Cliente"
                                       Margin="0,0,0,4"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#243447"/>

                            <ComboBox x:Name="cbFilterCustomer"
                                      Height="32"
                                      FontSize="13"
                                      DisplayMemberPath="Name"
                                      VerticalContentAlignment="Center"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="Data inicial"
                                       Margin="0,0,0,4"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#243447"/>

                            <DatePicker x:Name="dpStartDate"
                                        Height="32"
                                        FontSize="13"/>

                        </StackPanel>

                        <StackPanel Grid.Column="4">

                            <TextBlock Text="Data final"
                                       Margin="0,0,0,4"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#243447"/>

                            <DatePicker x:Name="dpEndDate"
                                        Height="32"
                                        FontSize="13"/>

                        </StackPanel>

                        <StackPanel Grid.Column="6">

                            <TextBlock Text="Estado de pagamento"
                                       Margin="0,0,0,4"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#243447"/>

                            <ComboBox x:Name="cbPaymentStatus"
                                      Height="32"
                                      FontSize="13"
                                      SelectedIndex="0"
                                      VerticalContentAlignment="Center">

                                <ComboBoxItem Content="Todas"/>
                                <ComboBoxItem Content="Pagas"/>
                                <ComboBoxItem Content="Não pagas"/>

                            </ComboBox>

                        </StackPanel>

                        <StackPanel Grid.Column="8"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Bottom">

                            <Button x:Name="btnClearFilters"
                                    Content="Limpar"
                                    Width="90"
                                    Height="32"
                                    Margin="0,0,8,0"
                                    Background="#E7ECF1"
                                    Foreground="#243447"
                                    BorderBrush="#C5CDD5"
                                    FontSize="12"
                                    Cursor="Hand"/>

                            <Button x:Name="btnSearch"
                                    Content="Pesquisar"
                                    Width="100"
                                    Height="32"
                                    Background="#176B87"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontSize="12"
                                    Cursor="Hand"/>

                        </StackPanel>

                    </Grid>

                    <DataGrid x:Name="dgInvoices"
                              Grid.Row="4"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderBrush="#D8DEE5"
                              BorderThickness="1"
                              RowHeight="30"
                              ColumnHeaderHeight="32"
                              FontSize="13">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Fatura"
                                                Binding="{Binding InvoiceId}"
                                                Width="75"/>

                            <DataGridTextColumn Header="Cliente"
                                                Binding="{Binding CustomerName}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Contador"
                                                Binding="{Binding MeterId}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Emissão"
                                                Binding="{Binding IssueDate, StringFormat=dd/MM/yyyy}"
                                                Width="115"/>

                            <DataGridTextColumn Header="Valor"
                                                Binding="{Binding InvoiceAmount, StringFormat={}{0:F2} €}"
                                                Width="110"/>

                            <DataGridCheckBoxColumn Header="Paga"
                                                    Binding="{Binding IsPaid}"
                                                    Width="85"/>

                            <DataGridCheckBoxColumn Header="Cancelada"
                                                    Binding="{Binding IsCancelled}"
                                                    Width="100"/>

                        </DataGrid.Columns>

                    </DataGrid>

                    <StackPanel Grid.Row="6"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button x:Name="btnViewInvoice"
                                Content="Ver fatura"
                                Width="110"
                                Height="34"
                                Margin="0,0,10,0"
                                Background="#5B6773"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="12"
                                Cursor="Hand"/>

                        <Button x:Name="btnMarkAsPaid"
                                Content="Marcar como paga"
                                Width="140"
                                Height="34"
                                Margin="0,0,10,0"
                                Background="#2E7D5B"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="12"
                                Cursor="Hand"/>

                        <Button x:Name="btnCancelInvoice"
                                Content="Anular fatura"
                                Width="125"
                                Height="34"
                                Background="#B64B4B"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="12"
                                Cursor="Hand"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

        <Border Grid.Row="2"
                Background="#173B63">

            <TextBlock Text="Sistema de Gestão de Água"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="White"/>

        </Border>

    </Grid>
</Window>
