<Window x:Class="WaterManagementSystem.Wpf.Windows.CustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WaterManagementSystem.Wpf.Windows"
        mc:Ignorable="d"
        Title="Customer Management"
        Width="1024"
        Height="768"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Background="#F5F7FA">
    <Grid>


        <Grid.RowDefinitions>
            <RowDefinition Height="105"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#173B63">

            <Grid Margin="35,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="/WaterManagementSystem.Wpf;component/Images/logo.png"
                       Width="100"
                       Height="100"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="Gestão de Clientes"
                               FontSize="23"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <TextBlock Text="Registo e consulta dos clientes"
                               Margin="0,4,0,0"
                               FontSize="14"
                               Foreground="#DCE7F2"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="40,15,40,15">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">

                <TextBlock Text="Gestão de Clientes"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#1D2C3C"/>

                <TextBlock Text="Registe e consulte os clientes do sistema."
                           Margin="0,3,0,0"
                           FontSize="13"
                           Foreground="#677482"/>
            </StackPanel>

            <Border Grid.Row="2"
                    Padding="14"
                    Background="White"
                    BorderBrush="#D8DEE5"
                    BorderThickness="1"
                    CornerRadius="6">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0"
                                Grid.Column="0">

                        <TextBlock Text="Nome"
                                   Margin="0,0,0,4"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#243447"/>

                        <TextBox x:Name="txtName"
                                 Height="32"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0"
                                Grid.Column="2">

                        <TextBlock Text="Contacto"
                                   Margin="0,0,0,4"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#243447"/>

                        <TextBox x:Name="txtPhone"
                                 Height="32"
                                 FontSize="14"
                                 MaxLength="9"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0"
                                Grid.Column="4">

                        <TextBlock Text="NIF"
                                   Margin="0,0,0,4"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#243447"/>

                        <TextBox x:Name="txtTaxNumber"
                                 Height="32"
                                 FontSize="14"
                                 MaxLength="9"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="3">

                        <TextBlock Text="Morada"
                                   Margin="0,0,0,4"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#243447"/>

                        <TextBox x:Name="txtAddress"
                                 Height="32"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                Grid.Column="4">

                        <TextBlock Text="Email"
                                   Margin="0,0,0,4"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#243447"/>

                        <TextBox x:Name="txtEmail"
                                 Height="32"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4"
                                Grid.Column="0"
                                Grid.ColumnSpan="5"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button x:Name="btnClear"
                                Content="Limpar"
                                Click="btnClear_Click"
                                Width="110"
                                Height="34"
                                Margin="0,0,10,0"
                                Background="#E7ECF1"
                                Foreground="#243447"
                                BorderBrush="#C5CDD5"
                                FontSize="14"
                                Cursor="Hand"/>

                        <Button x:Name="btnAdd"
                                Content="Registar"
                                Click="btnAdd_Click"
                                Width="110"
                                Height="34"
                                Background="#176B87"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="14"
                                Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Grid.Row="4"
                       Text="Clientes registados"
                       Margin="0,0,0,12"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#243447"/>

            <Border Grid.Row="5"
                    Background="White"
                    BorderBrush="#D8DEE5"
                    BorderThickness="1"
                    CornerRadius="6"
                    MinHeight="210">

                <DataGrid x:Name="dgCustomers"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          CanUserAddRows="False"
                          RowHeight="30"
                          ColumnHeaderHeight="30"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          Background="White"
                          BorderBrush="#D8DEE5"
                          AlternatingRowBackground="#F6F8FA">


                    <DataGrid.Columns>

                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding CustomerId}"
                                            Width="55"/>

                        <DataGridTextColumn Header="Nome"
                                            Binding="{Binding Name}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Contacto"
                                            Binding="{Binding Phone}"
                                            Width="110"/>

                        <DataGridTextColumn Header="NIF"
                                            Binding="{Binding TaxNumber}"
                                            Width="110"/>

                        <DataGridTextColumn Header="Email"
                                            Binding="{Binding Email}"
                                            Width="*"/>

                        <DataGridCheckBoxColumn Header="Ativo"
                                                Binding="{Binding IsActive}"
                                                Width="70"/>

                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <StackPanel Grid.Row="6"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0">

                <Button x:Name="btnEdit"
                        Content="Editar"
                        Click="btnEdit_Click"
                        Width="110"
                        Height="34"
                        Margin="0,0,10,0"
                        Background="#E7ECF1"
                        Foreground="#243447"
                        BorderBrush="#C5CDD5"
                        FontSize="14"
                        Cursor="Hand"/>

                <Button x:Name="btnDelete"
                        Content="Apagar"
                        Click="btnDelete_Click"
                        Width="110"
                        Height="34"
                        Background="#B33A3A"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Background="#173B63">

            <TextBlock Text="Sistema de Gestão de Água"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="White"/>
        </Border>

    </Grid>
</Window>
