<Window x:Class="WaterManagementSystem.Wpf.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WaterManagementSystem.Wpf.Windows"
        mc:Ignorable="d"
        Title="About" 
        Width="1024"
        Height="768"
        MinHeight="650"
        MinWidth="1000"
        Background="#F5F7FA"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F4F7FA">

        <Grid.RowDefinitions>
            <RowDefinition Height="105"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0"
            Background="#1E466F"
            BorderBrush="#2D6EA5"
            BorderThickness="0,0,0,2">

            <Grid Margin="65,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                   Source="/Images/logo.png"
                   Width="85"
                   Height="85"
                   Stretch="Uniform"/>

                <StackPanel Grid.Column="1"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center">

                    <TextBlock Text="Sobre o Aqualis"
                           FontSize="23"
                           FontWeight="SemiBold"
                           Foreground="White"/>

                    <TextBlock Text="Sistema de Gestão de Água"
                           Margin="0,5,0,0"
                           FontSize="14"
                           Foreground="#E4EEF7"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- Área central -->
        <Grid Grid.Row="1"
          Margin="120,35">

            <Border Padding="35,28"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Background="White"
                BorderBrush="#D6DEE6"
                BorderThickness="1"
                CornerRadius="8">

                <StackPanel>

                    <!-- Logótipo central pequeno -->
                    <Image Source="/Images/logoAzul1.png"
                       Width="90"
                       Height="90"
                       HorizontalAlignment="Center"
                       Stretch="Uniform"/>

                    <TextBlock Text="Aqualis"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           FontSize="27"
                           FontWeight="SemiBold"
                           Foreground="#1E466F"/>

                    <TextBlock Text="Sistema de Gestão de Água"
                           Margin="0,4,0,18"
                           HorizontalAlignment="Center"
                           FontSize="15"
                           Foreground="#66788A"/>

                    <Border Height="1"
                        Margin="55,0,55,20"
                        Background="#D6DEE6"/>

                    <TextBlock Text="Versão 1.0.0"
                           HorizontalAlignment="Center"
                           FontSize="14"
                           Foreground="#66788A"/>

                    <TextBlock Text="Desenvolvido por"
                           Margin="0,16,0,3"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           Foreground="#66788A"/>

                    <TextBlock Text="Maria Franciele Torres"
                           HorizontalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#243447"/>

                    <TextBlock Text="2026"
                           Margin="0,12,0,0"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           Foreground="#66788A"/>

                    <TextBlock Text="Aplicação para gestão de clientes, contadores, leituras de consumo e faturação de água."
                           MaxWidth="520"
                           Margin="25,18,25,20"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="13"
                           Foreground="#66788A"/>

                    <Button x:Name="btnClose"
                        Width="120"
                        Height="38"
                        HorizontalAlignment="Center"
                        Content="Fechar"
                        Click="btnClose_Click"/>

                </StackPanel>

            </Border>

        </Grid>

        <!-- Rodapé -->
        <Border Grid.Row="2"
            Background="#1E466F"
            BorderBrush="#2D6EA5"
            BorderThickness="0,2,0,0">

            <TextBlock Text="Sistema de Gestão de Água"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="12"
                   Foreground="White"/>

        </Border>

    </Grid>
</Window>
