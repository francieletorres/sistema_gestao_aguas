<Window x:Class="WaterManagementSystem.Wpf.Windows.MeterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WaterManagementSystem.Wpf.Windows"
        mc:Ignorable="d"
        Title="Meter Window" 
        Width="1024"
        Height="768"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="110"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

       
        <Border Grid.Row="0"
                Background="#17365D">

            <Grid Margin="40,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
          Source="/WaterManagementSystem.Wpf;component/Images/logo.png"
          Width="100"
          Height="100"
          Stretch="Uniform"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Margin="25,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="Gestão de Contadores"
                               FontSize="23"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <TextBlock Text="Registo e consulta dos contadores dos clientes"
                               Margin="0,5,0,0"
                               FontSize="14"
                               Foreground="#DCE7F2"/>
                </StackPanel>
            </Grid>
        </Border>

        
        <Grid Grid.Row="1"
              Margin="45,25,45,25">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            
            <StackPanel Grid.Row="0">

                <TextBlock Text="Gestão de Contadores"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#1D2C3C"/>

                <TextBlock Text="Registe e consulte os contadores associados aos clientes."
                           Margin="0,5,0,0"
                           FontSize="14"
                           Foreground="#677482"/>
            </StackPanel>

            <Border Grid.Row="2"
                    Padding="22"
                    Background="White"
                    BorderBrush="#D8DEE5"
                    BorderThickness="1"
                    CornerRadius="6">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="25"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="25"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                   
                    <StackPanel Grid.Row="0"
                                Grid.Column="0">

                        <TextBlock Text="Cliente"
                                   Margin="0,0,0,6"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#243447"/>

                        <ComboBox x:Name="cbCustomers"
                                  Height="38"
                                  FontSize="14"
                                  SelectionChanged="cbCustomers_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0"
                                Grid.Column="2">

                        <TextBlock Text="Data de instalação"
                                   Margin="0,0,0,6"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#243447"/>

                        <DatePicker x:Name="dpInstallationDate"
                                    Height="38"
                                    FontSize="14"
                                    IsEnabled="False"/>
                    </StackPanel>


                    <StackPanel Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="5"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button x:Name="btnClear"
                                Content="Limpar"
                                Click="btnClear_Click"
                                Width="115"
                                Height="40"
                                Margin="0,0,10,0"
                                Background="#E7ECF1"
                                Foreground="#243447"
                                BorderBrush="#C5CDD5"
                                FontSize="14"/>

                        <Button x:Name="btnCreate"
                                Content="Registar"
                                Click="btnCreate_Click"
                                Width="115"
                                Height="40"
                                Background="#176B87"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="14"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Grid.Row="4"
                       Text="Contadores registados"
                       Margin="0,0,0,10"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#243447"/>

            <DataGrid x:Name="dgMeters"
                      Grid.Row="5"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserAddRows="False"
                      RowHeight="30"
                      ColumnHeaderHeight="34"
                      GridLinesVisibility="Horizontal"
                      Background="White"
                      BorderBrush="#D8DEE5"
                      AlternatingRowBackground="#F6F8FA" >

                <DataGrid.Columns>

                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding MeterId}"
                                        Width="80"/>

                    <DataGridTextColumn Header="Cliente"
                                        Binding="{Binding CustomerName}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Data de instalação"
                                        Binding="{Binding InstallationDate,
                                        StringFormat={}{0:dd/MM/yyyy}}"
                                        Width="190"/>

                    <DataGridCheckBoxColumn Header="Ativo"
                                            Binding="{Binding IsActive}"
                                            Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="6"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,15,0,0">

                <Button x:Name="btnEdit"
                        Content="Editar"
                        Click="btnEdit_Click"
                        Width="115"
                        Height="40"
                        Margin="0,0,10,0"
                        Background="#E7ECF1"
                        Foreground="#243447"
                        BorderBrush="#C5CDD5"
                        FontSize="14"/>

                <Button x:Name="btnDelete"
                        Content="Apagar"
                        Click="btnDelete_Click"
                        Width="115"
                        Height="40"
                        Background="#B33A3A"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Background="#17365D">

            <TextBlock Text="Sistema de Gestão de Água"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="White"/>
        </Border>
    </Grid>
</Window>
