<Window x:Class="WaterManagementSystem.Wpf.Windows.InvoiceDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WaterManagementSystem.Wpf.Windows"
        mc:Ignorable="d"
        Title="InvoiceDetailsWindow" 
        Width="1024"
        Height="768"
        MinHeight="650"
        MinWidth="1000"
        Background="#F5F7FA"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#D8DEE5"
                BorderThickness="1"
                CornerRadius="5"
                Padding="38" Height="638" VerticalAlignment="Top">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center">

                        <TextBlock Text="AQUALIS"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#173B63"/>

                        <TextBlock Text="Sistema de Gestão de Água"
                                   Margin="0,4,0,0"
                                   FontSize="13"
                                   Foreground="#677482"/>

                        <TextBlock Text="Documento de faturação de consumo"
                                   Margin="0,2,0,0"
                                   FontSize="12"
                                   Foreground="#87919C"/>

                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Right">

                        <Image Source="/WaterManagementSystem.Wpf;component/Images/logoAzul1.png"
                               Width="110"
                               Height="90"
                               Stretch="Uniform"
                               HorizontalAlignment="Right"/>

                        <TextBlock Text="FATURA"
                                   Margin="0,4,0,0"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="#173B63"
                                   HorizontalAlignment="Right"/>

                    </StackPanel>

                </Grid>

                <Border Grid.Row="1"
                        Height="1"
                        Background="#D8DEE5"
                        VerticalAlignment="Center"/>

                <Grid Grid.Row="2">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Faturar a"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#677482"/>

                        <TextBlock x:Name="txtCustomerName"
                                   Margin="0,7,0,0"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#1D2C3C"/>

                        <StackPanel Margin="0,5,0,0"
                                    Orientation="Horizontal">

                            <TextBlock Text="Morada: "
                                       FontSize="13"
                                       Foreground="#677482"/>

                            <TextBlock x:Name="txtCustomerAddress"
                                       FontSize="13"
                                       Foreground="#354657"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Margin="0,4,0,0"
                                    Orientation="Horizontal">

                            <TextBlock Text="Contacto: "
                                        FontSize="13"
                                        Foreground="#677482"/>   

                            <TextBlock x:Name="txtCustomerPhone"
                                         FontSize="13"
                                         Foreground="#354657"/>
                        </StackPanel>

                        <StackPanel Margin="0,4,0,0"
                                    Orientation="Horizontal">

                            <TextBlock Text="Email: "
                                       FontSize="13"
                                       Foreground="#677482"/>

                            <TextBlock x:Name="txtCustomerEmail"
                                         FontSize="13"
                                         Foreground="#354657"/>
                        </StackPanel>

                        <StackPanel Margin="0,4,0,0"
                                    Orientation="Horizontal">

                            <TextBlock Text="NIF: "
                                       FontSize="13"
                                       Foreground="#677482"/>

                            <TextBlock x:Name="txtTaxNumber"
                                         FontSize="13"
                                         Foreground="#354657"/>
                        </StackPanel>

                    </StackPanel>

                    <Grid Grid.Column="2">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Fatura n.º"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#677482"/>

                        <TextBlock x:Name="txtInvoiceId"
                                   Grid.Row="0"
                                   Grid.Column="2"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#1D2C3C"/>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="Data de emissão:"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#677482"/>

                        <TextBlock x:Name="txtIssueDate"
                                   Grid.Row="2"
                                   Grid.Column="2"
                                   FontSize="14"
                                   Foreground="#1D2C3C"/>

                        <TextBlock Grid.Row="4"
                                   Grid.Column="0"
                                   Text="Estado:"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#677482"/>

                        <TextBlock x:Name="txtInvoiceStatus"
                                   Grid.Row="4"
                                   Grid.Column="2"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#1D2C3C"/>

                    </Grid>

                </Grid>

                <TextBlock Grid.Row="4"
                           Text="Detalhes do consumo"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#243447"/>

                <Border Grid.Row="6"
                        BorderBrush="#D8DEE5"
                        BorderThickness="1"
                        CornerRadius="3">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="48"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0"
                                Grid.Column="0"
                                Background="#EEF2F6"
                                BorderBrush="#D8DEE5"
                                BorderThickness="0,0,1,1">

                            <TextBlock Text="Contador"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#354657"/>
                        </Border>

                        <Border Grid.Row="0"
                                Grid.Column="1"
                                Background="#EEF2F6"
                                BorderBrush="#D8DEE5"
                                BorderThickness="0,0,1,1">

                            <TextBlock Text="Data da leitura"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#354657"/>
                        </Border>

                        <Border Grid.Row="0"
                                Grid.Column="2"
                                Background="#EEF2F6"
                                BorderBrush="#D8DEE5"
                                BorderThickness="0,0,1,1">

                            <TextBlock Text="Leitura"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#354657"/>
                        </Border>

                        <Border Grid.Row="0"
                                Grid.Column="3"
                                Background="#EEF2F6"
                                BorderBrush="#D8DEE5"
                                BorderThickness="0,0,0,1">

                            <TextBlock Text="Volume"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#354657"/>
                        </Border>

                        <Border Grid.Row="1"
                                Grid.Column="0"
                                BorderBrush="#D8DEE5"
                                BorderThickness="0,0,1,0">

                            <TextBlock x:Name="txtMeterId"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="#1D2C3C"/>
                        </Border>

                        <Border Grid.Row="1"
                                Grid.Column="1"
                                BorderBrush="#D8DEE5"
                                BorderThickness="0,0,1,0">

                            <TextBlock x:Name="txtReadingDate"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="#1D2C3C"/>
                        </Border>

                        <Border Grid.Row="1"
                                Grid.Column="2"
                                BorderBrush="#D8DEE5"
                                BorderThickness="0,0,1,0">

                            <TextBlock x:Name="txtMeterReading"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="#1D2C3C"/>
                        </Border>

                        <TextBlock x:Name="txtConsumedVolume"
                                   Grid.Row="1"
                                   Grid.Column="3"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="#1D2C3C"/>

                    </Grid>

                </Border>

                <Grid Grid.Row="8">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="1"
                            Background="#F5F7FA"
                            BorderBrush="#D8DEE5"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="18">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>


                            <TextBlock 
                                       Grid.Column="0"
                                       Text="Total a pagar:"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#173B63"/>

                            <TextBlock x:Name="txtInvoiceAmount"
                                       Grid.Row="2"
                                       Grid.Column="1"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#173B63"/>

                        </Grid>

                    </Border>

                </Grid>

            </Grid>

        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,0,40,0">

            <Button x:Name="btnClose"
                    Content="Fechar"
                    Click="btnClose_Click"
                    Width="100"
                    Height="36"
                    Background="#176B87"
                    Foreground="White"
                    BorderBrush="#C5CDD5"
                    FontSize="13"
                    Cursor="Hand"/>

        </StackPanel>

    </Grid>
</Window>
