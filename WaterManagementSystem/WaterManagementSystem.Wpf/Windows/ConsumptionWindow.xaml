<Window x:Class="WaterManagementSystem.Wpf.Windows.ConsumptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WaterManagementSystem.Wpf.Windows"
        mc:Ignorable="d"
        Title="Consumptions"    
        Width="1024"
        Height="768"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA"
        Loaded="Window_Loaded" >
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="105"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#173B63">

            <Grid Margin="35,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="/WaterManagementSystem.Wpf;component/Images/logo.png"
                       Width="100"
                       Height="100"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="Gestão de Consumos"
                               FontSize="23"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <TextBlock Text="Registo e consulta das leituras dos contadores"
                               Margin="0,4,0,0"
                               FontSize="14"
                               Foreground="#DCE7F2"/>

                </StackPanel>

            </Grid>

        </Border>

        <Grid Grid.Row="1"
              Margin="45,25,45,20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">

                <TextBlock Text="Gestão de Consumos"
                           FontSize="25"
                           FontWeight="SemiBold"
                           Foreground="#1D2C3C"/>

                <TextBlock Text="Registe e consulte os consumos associados aos contadores."
                           Margin="0,4,0,0"
                           FontSize="14"
                           Foreground="#677482"/>

            </StackPanel>

            <Border Grid.Row="2"
                    Padding="20"
                    Background="White"
                    BorderBrush="#D8DEE5"
                    BorderThickness="1"
                    CornerRadius="6">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0"
                                Grid.Column="0">

                        <TextBlock Text="Cliente"
                                   Margin="0,0,0,5"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#243447"/>

                        <ComboBox x:Name="cbCustomers"
                                  Height="34"
                                  FontSize="14"                                
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="cbCustomers_SelectionChanged"
                                  />

                    </StackPanel>

                    <StackPanel Grid.Row="0"
                                Grid.Column="2">

                        <TextBlock Text="Contador"
                                   Margin="0,0,0,5"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#243447"/>

                        <ComboBox x:Name="cbMeters"
                                  Height="34"
                                  FontSize="14"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="cbMeters_SelectionChanged"
                                 />

                    </StackPanel>

                    <StackPanel Grid.Row="0"
                                Grid.Column="4">

                        <TextBlock Text="Data da leitura"
                                   Margin="0,0,0,5"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#243447"/>

                        <DatePicker x:Name="dpReadingDate"
                                    Height="34"
                                    FontSize="14"
                                    IsEnabled="False"/>

                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                Grid.Column="0">

                        <TextBlock Text="Leitura"
                                   Margin="0,0,0,5"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#243447"/>

                        <TextBox x:Name="txtMeterReading"
                                 Height="34"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                Grid.Column="2"
                                Grid.ColumnSpan="3">

                        <TextBlock Text="Observação"
                                   Margin="0,0,0,5"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#243447"/>

                        <TextBox x:Name="txtNotes"
                                 Height="34"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <StackPanel Grid.Row="4"
                                Grid.Column="0"
                                Grid.ColumnSpan="5"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button x:Name="btnClear"
                                Content="Limpar"
                                Click="btnClear_Click"
                                Width="110"
                                Height="36"
                                Margin="0,0,10,0"
                                Background="#E7ECF1"
                                Foreground="#243447"
                                BorderBrush="#C5CDD5"
                                FontSize="14"
                                Cursor="Hand"/>

                        <Button x:Name="btnCreate"
                                Content="Registar"
                                
                                Width="110"
                                Height="36"
                                Background="#176B87"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="14"
                                Cursor="Hand"
                                Click="btnCreate_Click"/>

                    </StackPanel>

                </Grid>

            </Border>

            <Grid Grid.Row="4">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">

                    <TextBlock Text="Consumos registados"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#1D2C3C"/>

                    <TextBlock Text="Selecione um consumo para editar ou eliminar."
                               Margin="0,3,0,0"
                               FontSize="13"
                               Foreground="#677482"/>

                </StackPanel>

                <DataGrid x:Name="dgConsumptions"
                          Grid.Row="2"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderBrush="#D8DEE5"
                          BorderThickness="1"
                          RowHeight="30"
                          ColumnHeaderHeight="32">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding ConsumptionId}"
                                            Width="55"/>

                        <DataGridTextColumn Header="Cliente"
                                            Binding="{Binding CustomerName}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Contador"
                                            Binding="{Binding MeterId}"
                                            Width="80"/>

                        <DataGridTextColumn Header="Data"
                                            Binding="{Binding ReadingDate, StringFormat=dd/MM/yyyy}"
                                            Width="95"/>

                        <DataGridTextColumn Header="Leitura"
                                            Binding="{Binding MeterReading}"
                                            Width="85"/>

                        <DataGridTextColumn Header="Volume"
                                            Binding="{Binding ConsumedVolume}"
                                            Width="85"/>

                        <DataGridTextColumn Header="Observação"
                                            Binding="{Binding Notes}"
                                            Width="*"/>

                        <DataGridCheckBoxColumn Header="Faturado"
                                                Binding="{Binding HasInvoice}"
                                                Width="75"/>

                    </DataGrid.Columns>

                </DataGrid>

                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button x:Name="btnEdit"
                            Content="Editar"
                            Click="btnEdit_Click"
                            Width="110"
                            Height="36"
                            Margin="0,0,10,0"
                            Background="#E7ECF1"
                            Foreground="#243447"
                            BorderBrush="#C5CDD5"
                            FontSize="14"
                            Cursor="Hand"/>

                    <Button x:Name="btnDelete"
                            Content="Eliminar"
                            Click="btnDelete_Click"
                            Width="110"
                            Height="36"
                            Background="#A94442"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="14"
                            Cursor="Hand"/>

                </StackPanel>

            </Grid>

        </Grid>

        <Border Grid.Row="2"
                Background="#173B63">

            <TextBlock Text="Sistema de Gestão de Água"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="White"/>

        </Border>

    </Grid>
</Window>
