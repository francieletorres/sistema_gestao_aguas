<Window x:Class="WaterManagementSystem.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WaterManagementSystem.Wpf"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Water Management System"   
        Width="1024"
        Height="768"
        MinHeight="650"
        MinWidth="1000">
    <Window.Resources>

        <Style x:Key="MenuCardButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="145"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D9D9D9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="18,0,18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#173B63"/>
            <Setter Property="BorderBrush" Value="#173B63"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>
    <Grid Background="White">

        <Grid.RowDefinitions>
            <RowDefinition Height="140"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="130"/>
        </Grid.RowDefinitions>


        <Grid Grid.Row="0"
               Background="White">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="190"/>
            </Grid.ColumnDefinitions>


            <Image Grid.Column="0"
                   Source="/WaterManagementSystem.Wpf;component/Images/logoAzul1.png"
                   Width="120"
                   Height="120"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1"
                   Text="CONECTA VOCÊ AO QUE É ESSENCIAL"
                   Foreground="#173B63"
                   FontSize="22"
                   FontWeight="Bold"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center" />

            <Button x:Name="btnAbout"
                    Grid.Column="2"
                    Content="Sobre"
                    Width="100"
                    Height="48"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="#173B63"
                    Background="White"
                    BorderBrush="#173B63"
                    BorderThickness="1"
                    HorizontalAlignment="center"
                    VerticalAlignment="Center"
                    Margin="-20,0,0,0"/>
        </Grid>

        <!-- IMAGEM PRINCIPAL -->
        <Grid Grid.Row="1">

            <Image Source="/WaterManagementSystem.Wpf;component/Images/back.png"
                   Stretch="UniformToFill"/>

            <!-- Cards do menu -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,-50">

                <!-- Customers -->
                <Button x:Name="btnCustomers"
                        Style="{StaticResource MenuCardButtonStyle}"
                        Click="btnCustomers_Click">
                        
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Source="/WaterManagementSystem.Wpf;component/Images/Customer.png"
                               Width="55"
                               Height="55"
                               Stretch="Uniform"
                               Margin="0,12,0,14"/>
                        <TextBlock Text="Cadastrar Cliente"
                                   TextAlignment="Center"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#173B63"
                                   TextWrapping="Wrap"
                                   Width="120"/>
                    </StackPanel>
                </Button>

                <!-- Meters -->
                <Button x:Name="btnMeters"
                        Style="{StaticResource MenuCardButtonStyle}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Source="/WaterManagementSystem.Wpf;component/Images/meter.png"
                               Width="60"
                               Height="60"
                               Stretch="Uniform"
                               Margin="0,12,0,14"/>
                        <TextBlock Text="Cadastrar Contador"
                                   TextAlignment="Center"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#173B63"
                                   TextWrapping="Wrap"
                                   Width="120"/>
                    </StackPanel>
                </Button>

                <!-- Consumptions -->
                <Button x:Name="btnConsumptions"
                        Style="{StaticResource MenuCardButtonStyle}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Source="/WaterManagementSystem.Wpf;component/Images/Consumption.png"
                               Width="60"
                               Height="60"
                               Stretch="Uniform"
                               Margin="0,12,0,14"/>
                        <TextBlock Text="Registar&#x0a;Leitura"
                                   TextAlignment="Center"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#173B63"
                                   TextWrapping="Wrap"
                                   Width="120"/>
                    </StackPanel>
                </Button>

                <!-- Invoices -->
                <Button x:Name="btnInvoices"
                        Style="{StaticResource MenuCardButtonStyle}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Source="/WaterManagementSystem.Wpf;component/Images/invoice.png"
                               Width="60"
                               Height="60"
                               Stretch="Uniform"
                               Margin="0,12,0,14"/>
                        <TextBlock Text="Consultar Faturas"
                                   TextAlignment="Center"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#173B63"
                                   TextWrapping="Wrap"
                                   Width="120"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Grid>
    </Grid>
</Window>
