<Window x:Class="WaterManagementSystem.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WaterManagementSystem.Wpf"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Water Management System"   
        Width="1024"
        Height="768"
        MinHeight="650"
        MinWidth="1000"
        Background="#F5F7FA">
    <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="90"/>
                <RowDefinition Height="225"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <!-- CABEÇALHO -->
            <Border Grid.Row="0"
                Background="#173B63">

                <Grid Margin="45,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">

                        <TextBlock Text="Sistema de Gestão de Água"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                        <TextBlock Text="Gestão de clientes, contadores, consumos e faturas"
                               Margin="0,4,0,0"
                               FontSize="13"
                               Foreground="#DCE7F2"/>
                    </StackPanel>

                    <Button x:Name="btnAbout"
                        Grid.Column="1"
                        Content="Sobre"
                        Width="90"
                        Height="36"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="White"
                        Foreground="#173B63"
                        BorderBrush="White"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- LOGO CENTRAL -->
            <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <Image Source="/WaterManagementSystem.Wpf;component/Images/logoAzul1.png"
                   Width="145"
                   Height="145"
                   Stretch="Uniform"/>

                <TextBlock Text="Conecta você ao que é essencial"
                       Margin="0,8,0,0"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#173B63"
                       HorizontalAlignment="Center"/>

                <TextBlock Text="Selecione uma área para começar"
                       Margin="0,5,0,0"
                       FontSize="13"
                       Foreground="#677482"
                       HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- MENU -->
            <Grid Grid.Row="2"
              Margin="65,15,65,30">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                       Text="Menu principal"
                       FontSize="21"
                       FontWeight="SemiBold"
                       Foreground="#173B63"/>

                <Grid Grid.Row="2"
                  VerticalAlignment="Top">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CLIENTES -->
                    <Button x:Name="btnCustomers"
                        Grid.Column="0"
                        Click="btnCustomers_Click"
                        Width="190"
                        Height="160"
                        HorizontalAlignment="Center"
                        Background="White"
                        BorderBrush="#D8DEE5"
                        BorderThickness="1"
                        Cursor="Hand">

                        <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                            <Image Source="/WaterManagementSystem.Wpf;component/Images/Customer.png"
                               Width="48"
                               Height="48"
                               Stretch="Uniform"/>

                            <TextBlock Text="Clientes"
                                   Margin="0,10,0,0"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#173B63"
                                   HorizontalAlignment="Center"/>

                            <TextBlock Text="Registar e gerir clientes"
                                   Margin="0,6,0,0"
                                   Width="145"
                                   FontSize="12"
                                   Foreground="#677482"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                    <!-- CONTADORES -->
                    <Button x:Name="btnMeters"
                        Click="btnMeters_Click"
                        Grid.Column="2"
                        Width="190"
                        Height="160"
                        HorizontalAlignment="Center"
                        Background="White"
                        BorderBrush="#D8DEE5"
                        BorderThickness="1"
                        Cursor="Hand">

                        <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                            <Image Source="/WaterManagementSystem.Wpf;component/Images/meter.png"
                               Width="48"
                               Height="48"
                               Stretch="Uniform"/>

                            <TextBlock Text="Contadores"
                                   Margin="0,10,0,0"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#173B63"
                                   HorizontalAlignment="Center"/>

                            <TextBlock Text="Registar e gerir contadores"
                                   Margin="0,6,0,0"
                                   Width="145"
                                   FontSize="12"
                                   Foreground="#677482"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                    <!-- CONSUMOS -->
                    <Button x:Name="btnConsumptions"
                        Grid.Column="4"
                        Width="190"
                        Height="160"
                        HorizontalAlignment="Center"
                        Background="White"
                        BorderBrush="#D8DEE5"
                        BorderThickness="1"
                        Cursor="Hand">

                        <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                            <Image Source="/WaterManagementSystem.Wpf;component/Images/Consumption.png"
                               Width="48"
                               Height="48"
                               Stretch="Uniform"/>

                            <TextBlock Text="Consumos"
                                   Margin="0,10,0,0"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#173B63"
                                   HorizontalAlignment="Center"/>

                            <TextBlock Text="Registar leituras e consumos"
                                   Margin="0,6,0,0"
                                   Width="145"
                                   FontSize="12"
                                   Foreground="#677482"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                    <!-- FATURAS -->
                    <Button x:Name="btnInvoices"
                        Grid.Column="6"
                        Width="190"
                        Height="160"
                        HorizontalAlignment="Center"
                        Background="White"
                        BorderBrush="#D8DEE5"
                        BorderThickness="1"
                        Cursor="Hand">

                        <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                            <Image Source="/WaterManagementSystem.Wpf;component/Images/invoice.png"
                               Width="48"
                               Height="48"
                               Stretch="Uniform"/>

                            <TextBlock Text="Faturas"
                                   Margin="0,10,0,0"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#173B63"
                                   HorizontalAlignment="Center"/>

                            <TextBlock Text="Consultar e gerir faturas"
                                   Margin="0,6,0,0"
                                   Width="145"
                                   FontSize="12"
                                   Foreground="#677482"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <!-- RODAPÉ -->
            <Border Grid.Row="3"
                Background="#173B63">

                <TextBlock Text="© 2026 Aqualis. Todos os direitos reservados."
                       Foreground="White"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            </Border>

        </Grid>
</Window>
